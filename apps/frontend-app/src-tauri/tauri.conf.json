{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "frontend-app",
  "version": "0.1.0",
  "identifier": "com.example.frontendapp",
  "build": {
    "beforeDevCommand": "bun run --cwd ../frontend-web/apps/web dev --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run --cwd ../frontend-web build",
    "frontendDist": "../../frontend-web/apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "frontend-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
