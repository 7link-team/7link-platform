{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chaosplus",
  "version": "0.1.0",
  "identifier": "com.example.frontendapp",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": { "resources/local/": "local/" },
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
