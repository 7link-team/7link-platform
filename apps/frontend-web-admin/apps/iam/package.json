{
  "name": "iam",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test src",
    "generate:api-types": "bun scripts/generate-api-types.mjs",
    "audit:legacy": "node scripts/run-browser-audits.mjs",
    "audit:route-matrix": "node scripts/route-matrix-browser-audit.mjs",
    "audit:personal-security": "node scripts/personal-security-browser-audit.mjs",
    "audit:personal-lifecycle": "node scripts/personal-lifecycle-browser-audit.mjs",
    "audit:navigation": "node scripts/navigation-browser-audit.mjs",
    "audit:departments": "bun scripts/department-browser-audit.mjs",
    "audit:positions": "bun scripts/position-browser-audit.mjs",
    "audit:groups": "bun scripts/group-browser-audit.mjs",
    "audit:entities": "bun scripts/entity-browser-audit.mjs",
    "audit:tenants": "bun scripts/tenant-browser-audit.mjs",
    "audit:roles": "bun scripts/role-browser-audit.mjs",
    "audit:field-policies": "node scripts/field-policy-browser-audit.mjs",
    "audit:invitations": "bun scripts/invitation-browser-audit.mjs",
    "audit:access-requests": "bun scripts/access-request-browser-audit.mjs",
    "audit:access-reviews": "bun scripts/access-review-browser-audit.mjs",
    "audit:service-accounts": "bun scripts/service-account-browser-audit.mjs",
    "audit:scim": "bun scripts/scim-browser-audit.mjs",
    "audit:scim-actors": "node scripts/scim-actor-browser-audit.mjs",
    "audit:scim-targets": "node scripts/scim-target-browser-audit.mjs",
    "audit:session-tenant": "node scripts/session-tenant-browser-audit.mjs",
    "audit:profile": "node scripts/profile-browser-audit.mjs",
    "audit:archive-ui": "node scripts/archive-ui-browser-audit.mjs",
    "audit:permanent-erasure": "bun scripts/permanent-erasure-browser-audit.mjs",
    "audit:registration": "bun scripts/registration-browser-audit.mjs",
    "audit:passkey": "bun scripts/passkey-browser-audit.mjs",
    "preview": "vite preview"
