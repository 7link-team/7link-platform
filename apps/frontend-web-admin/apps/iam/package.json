{
  "name": "iam",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test src",
    "audit:departments": "bun scripts/department-browser-audit.mjs",
    "audit:positions": "bun scripts/position-browser-audit.mjs",
    "audit:groups": "bun scripts/group-browser-audit.mjs",
    "audit:entities": "bun scripts/entity-browser-audit.mjs",
    "audit:tenants": "bun scripts/tenant-browser-audit.mjs",
    "audit:roles": "bun scripts/role-browser-audit.mjs",
    "audit:invitations": "bun scripts/invitation-browser-audit.mjs",
    "audit:access-requests": "bun scripts/access-request-browser-audit.mjs",
    "audit:access-reviews": "bun scripts/access-review-browser-audit.mjs",
    "audit:service-accounts": "bun scripts/service-account-browser-audit.mjs",
    "audit:scim": "bun scripts/scim-browser-audit.mjs",
    "audit:registration": "bun scripts/registration-browser-audit.mjs",
    "audit:passkey": "bun scripts/passkey-browser-audit.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
