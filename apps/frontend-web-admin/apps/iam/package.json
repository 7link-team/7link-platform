  "dependencies": {
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.58.2",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
