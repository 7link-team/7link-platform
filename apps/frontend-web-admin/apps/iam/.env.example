# Browser calls stay on the same origin and are forwarded by Vite or Nginx.
VITE_API_URL=/api

# Development-only proxy destination. This value is not embedded in the bundle.
VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# Initial tenant until the operator selects another tenant.
VITE_DEFAULT_TENANT=platform

# Console display name shown in the header and page chrome.
# Leave unset for a neutral "IAM"; the build carries no brand of its own.
VITE_APP_NAME=

# Organization named in the footer copyright line.
# Leave unset to show only the year.
VITE_ORG_NAME=
